filters:
  and:
    - file.ext == "md"
formulas:
  section: |
    if(file.inFolder("Concepts"), "Concepts",
    if(file.inFolder("Entities"), "Entities",
    if(file.inFolder("Projects"), "Projects",
    if(file.inFolder("Ideas"), "Ideas",
    if(file.inFolder("Research"), "Research",
    if(file.inFolder("Raw"), "Raw", "Uncategorized"))))))
  last_modified: file.mtime.relative()
properties:
  title:
    displayName: Title
  formula.section:
    displayName: Section
  formula.last_modified:
    displayName: Updated
views:
  - type: table
    name: All Content
    groupBy:
      property: formula.section
      direction: ASC
    order:
      - title
      - formula.section
      - formula.last_modified
    sort:
      - property: title
        direction: ASC
  - type: table
    name: Recently Updated
    order:
      - title
      - formula.last_modified
    sort:
      - property: formula.last_modified
        direction: DESC
    limit: 15
  - type: board
    name: By Section (Board)
    groupBy:
      property: formula.section
      direction: ASC
    order:
      - title
      - formula.last_modified
