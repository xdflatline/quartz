filters:
  and:
    - file.inFolder("Research")
views:
  - type: table
    name: "All Research"
    properties:
      - title
      - tags
      - description
    sort:
      - property: title
        direction: asc
  - type: list
    name: "Compact List"
    properties:
      - title
      - description
    sort:
      - property: title
        direction: asc
