filters:
  and:
    - file.inFolder("Notes")
views:
  - type: table
    name: "All Notes"
    properties:
      - title
      - tags
      - description
    sort:
      - property: title
        direction: asc
  - type: table
    name: "By Category"
    properties:
      - title
      - tags
      - description
    groups:
      - property: tags
    sort:
      - property: title
        direction: asc
  - type: list
    name: "Compact List"
    properties:
      - title
      - description
    sort:
      - property: title
        direction: asc